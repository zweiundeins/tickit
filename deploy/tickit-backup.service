# /etc/systemd/system/tickit-backup.service: a consistent copy of the database
# (VACUUM INTO) while the server runs, checked with PRAGMA integrity_check.
# The backup command keeps the newest 30 copies in /var/lib/tickit/backups, a
# month at one a day. A copy that fails the check stays as .bad, no copy is
# deleted, and the unit fails.
[Unit]
Description=Back up the tickit database

[Service]
Type=oneshot
User=tickit
Group=tickit
StateDirectory=tickit
StateDirectoryMode=0700
ExecStart=/opt/tickit/tickit backup -db /var/lib/tickit/tickit.db -backups /var/lib/tickit/backups -keep 30
Nice=10
IOSchedulingClass=idle
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
CapabilityBoundingSet=
UMask=0077
