# /etc/systemd/system/tickit-backup.service: a consistent copy of the database
# (VACUUM INTO) while the server runs. The backup command keeps the newest 28
# copies in /var/lib/tickit/backups: a week at four a day.
[Unit]
Description=Back up the tickit database

[Service]
Type=oneshot
User=tickit
Group=tickit
StateDirectory=tickit
ExecStart=/opt/tickit/tickit backup -db /var/lib/tickit/tickit.db -backups /var/lib/tickit/backups -keep 28
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateNetwork=yes
CapabilityBoundingSet=
UMask=0077
