# /etc/systemd/system/tickit.service: tickit on tickitdemo.zweiundeins.gmbh.
[Unit]
Description=tickit (issue tracker and wiki demo, Go, Datastar, SQLite)
Documentation=https://github.com/mbolli/tickit/blob/master/docs/deploy.md
After=network-online.target
Wants=network-online.target

[Service]
User=tickit
Group=tickit
# /var/lib/tickit holds the database and its backups, the only state.
StateDirectory=tickit
StateDirectoryMode=0700
WorkingDirectory=/var/lib/tickit
# Optional, mode 0600: TICKIT_* settings the command line leaves out.
EnvironmentFile=-/etc/tickit/tickit.env
# The site on 127.0.0.1:7105 for Caddy, /metrics on 127.0.0.1:7205 (port +
# 100) for Prometheus only. -secure: Caddy serves HTTPS, so a __Host- cookie
# and HSTS. Logs: slog text on stderr, into the journal.
ExecStart=/opt/tickit/tickit serve \
	-addr 127.0.0.1:7105 \
	-metrics 127.0.0.1:7205 \
	-db /var/lib/tickit/tickit.db \
	-secure \
	-streams 200
Restart=always
RestartSec=1
# SIGTERM: the streams end with sse.Reconnect, requests get 10 s to finish
# and still reach the writer, the projectors stop, the writer commits what
# is queued, the database closes. 30 s covers that with room to spare.
KillSignal=SIGTERM
TimeoutStopSec=30
LimitNOFILE=65536

# Memory, from lith's template for -streams 200. The hub gives the streams
# half of GOMEMLIMIT, 224 MiB, for their encoders, 32 KiB each and the views'
# frames: about 129 streams at zstd 2^19 and about 250 once the budget moves
# them to 2^18 with low memory, so 200 fit. The other half is the process and
# the garbage between collections. GOMEMLIMIT makes the collector work harder
# before MemoryHigh throttles and MemoryMax ends the process. Change these
# and -streams together.
Environment=GOMEMLIMIT=448MiB
MemoryHigh=512M
MemoryMax=640M
TasksMax=256
# Half the weight of the host's other units when the cores are busy.
CPUWeight=50

# Network: loopback only, both ways. Caddy and Prometheus connect from
# 127.0.0.1; tickit itself connects nowhere (it sends no mail). It may bind
# its two ports and no other. Not IPAddressDeny=localhost, the template's
# setting for a Unix socket: on a loopback port it would shut Caddy out too.
IPAddressDeny=any
IPAddressAllow=localhost
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SocketBindAllow=tcp:7105
SocketBindAllow=tcp:7205
SocketBindDeny=any

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077

[Install]
WantedBy=multi-user.target
