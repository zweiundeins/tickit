# Caddy 2: tickit's site block, as /etc/caddy/sites/tickit.caddy (the
# host's Caddyfile imports that folder). It only proxies: tickit serves
# everything itself, compresses its pages and streams (so no
# `encode`), and sets its own security headers (NFR-19). Unit `tickit`,
# loopback :7105; its /metrics listen on :7205 for Prometheus only.
tickit.zweiundeins.gmbh {
	log {
		output file /var/log/caddy/tickit-access.log {
			mode 0640
			roll_size 100mb
			roll_keep 5
			roll_keep_for 720h
		}
		# A tab id lets whoever has it pace or end that tab's stream: the
		# log keeps a hash of it.
		format filter {
			wrap json
			fields {
				request>uri query {
					hash tab
				}
			}
		}
	}

	# The largest body tickit takes is an edit batch of 256 KiB, but for an
	# image upload (FR-85): a file of 5 MB in a multipart body. The two
	# matchers exclude each other, since both limits would apply otherwise.
	@upload path_regexp ^/cmd/(pages/[^/]+|issues/[^/]+/description)/image$
	@other {
		not path_regexp ^/cmd/(pages/[^/]+|issues/[^/]+/description)/image$
	}
	request_body @upload {
		max_size 6MB
	}
	request_body @other {
		max_size 1MB
	}

	reverse_proxy 127.0.0.1:7105 {
		# The client's address for the rate limits. tickit takes it only from
		# loopback, the last X-Forwarded-For address before X-Real-IP, and a
		# client cannot set either: these replace them.
		header_up X-Forwarded-For {http.request.remote.host}
		header_up X-Real-IP {http.request.remote.host}
		# Server-sent events: pass every write through at once.
		flush_interval -1
	}
}
