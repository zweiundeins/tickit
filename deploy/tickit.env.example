# /etc/tickit/tickit.env, root:root, mode 0600: settings the unit's command
# line leaves out. Every flag of `tickit serve -h` can be set here as
# TICKIT_<FLAG>, -session-ttl as TICKIT_SESSION_TTL; the command line wins.
# docs/deploy.md has the table with every setting and its default.
#TICKIT_SYNCHRONOUS=NORMAL
#TICKIT_SESSION_TTL=720h
#TICKIT_DEBUG=false
