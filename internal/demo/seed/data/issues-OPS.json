    {
      "key": "OPS-8",
      "type": "Bug",
      "summary": "Migration 0142 fails on PostgreSQL 18: implicit cast in a view",
      "status": "Done",
      "priority": "High",
      "assignee": "s-mateo",
      "reporter": "s-mateo",
      "parent": "OPS-1",
      "labels": ["database", "migration"],
      "components": ["Database"],
      "due": null,
      "points": null,
      "estimate": "",
      "remaining": "",
      "watchers": [],
      "created": "-27d 10:00",
      "description": [
        "```text",
        "ERROR:  operator does not exist: text = integer",
        "LINE 4:   WHERE o.status = 3",
        "```",
        "",
        "The view compared a text column with a number and relied on an old implicit cast."
      ],
      "history": [
        {"at": "-27d 10:05", "by": "s-mateo", "field": "status", "from": "To Do", "to": "In Progress"},
        {"at": "-26d 11:00", "by": "s-mateo", "field": "status", "from": "In Progress", "to": "In Review"},
        {"at": "-26d 14:00", "by": "s-tomasz", "field": "status", "from": "In Review", "to": "Done"}
      ],
      "links": [],
      "comments": [
        {
          "by": "s-mateo",
          "at": "-26d 10:50",
          "body": [
            "Fixed with an explicit status name, and a new migration rather than editing 0142, since it has shipped:",
            "",
            "```sql",
            "CREATE OR REPLACE VIEW open_orders AS",
            "SELECT o.* FROM orders o WHERE o.status = 'paid';",
            "```"
          ]
        }
      ]
    },
