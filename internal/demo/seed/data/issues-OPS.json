    {
      "key": "OPS-5",
      "type": "Story",
      "summary": "cairn indexer reads changes from the outbox",
      "status": "Done",
      "priority": "High",
      "assignee": "s-mateo",
      "reporter": "s-mateo",
      "parent": "OPS-2",
      "labels": ["performance"],
      "components": ["Search index", "API"],
      "due": null,
      "points": 8,
      "estimate": "",
      "remaining": "",
      "watchers": [],
      "created": "-29d 11:00",
      "description": [
        "summit writes a row to `outbox` in the same transaction as the product change. The indexer reads rows in order and remembers the last id it saw.",
        "",
        "```sql",
        "SELECT id, topic, payload",
        "FROM outbox",
        "WHERE id > $1 AND topic LIKE 'product.%'",
        "ORDER BY id",
        "LIMIT 500;",
        "```"
      ],
      "history": [
        {"at": "-29d 11:30", "by": "s-mateo", "field": "status", "from": "To Do", "to": "In Progress"},
        {"at": "-22d 16:00", "by": "s-mateo", "field": "status", "from": "In Progress", "to": "In Review"},
        {"at": "-21d 11:00", "by": "s-tomasz", "field": "status", "from": "In Review", "to": "Done"}
      ],
      "links": [],
      "comments": [
        {
          "by": "s-tomasz",
          "at": "-22d 17:00",
          "body": "Looks right. Please add a metric for the lag between the newest outbox row and the indexer's position, we will want to alert on it."
        },
        {
          "by": "s-mateo",
          "at": "-21d 10:00",
          "body": "Added `cairn_outbox_lag_seconds`. Typical value 1.4 s."
        }
      ]
    },
