package ui

import (
	"strconv"

	"github.com/zweiundeins/starbase/templ/sb"
)

// VirtualProps is Starbase's sb-virtual-scroll: a long list of which the
// server renders a window, one fixed-height row per item. Load its bundle
// ("virtual-scroll").
type VirtualProps struct {
	ID string
	// Label names the list: "Recent activity".
	Label string
	// Role hands the list's semantics to the host: "feed" for articles that
	// arrive as the reader scrolls; empty for a plain list.
	Role string
	// Total is how many items the whole list has, -1 while the server does
	// not know; Offset the index of the first child in it.
	Total, Offset int
	// ItemSize is the row's height: px or a CSS length ("var(--tk-feed-row)"),
	// which the component measures. Buffer is how far a window reaches past
	// the viewport, in px; Step what a window's start and end are multiples
	// of, so that readers at about the same place share it.
	ItemSize     string
	Buffer, Step int
	Hidden       bool
	Class            string
	Attrs            templ.Attributes
}

// VirtualList is sb-virtual-scroll; the children are the window's items,
// in order. The component asks for another window with sb-window
// {offset, count}, which the feature answers with a frame. Before the
// bundle defines it, the window scrolls as a plain box.
templ VirtualList(p VirtualProps) {
	@sb.VirtualScroll(virtualProps(p)) {
		{ children... }
	}
}

func virtualProps(p VirtualProps) sb.VirtualScrollProps {
	v := sb.VirtualScrollProps{
		ID:       p.ID,
		Class:    classes("tk-virtual", p.Class),
		Total:    sb.Num(float64(p.Total)),
		ItemSize: p.ItemSize,
		Attrs:    p.Attrs,
	}
	if p.Buffer > 0 {
		v.Buffer = sb.Num(float64(p.Buffer))
	}
	if p.Step > 1 {
		v.Step = sb.Num(float64(p.Step))
	}
	// sb.VirtualScrollProps.Offset leaves 0 out; the feeds read offset="0".
	a := templ.Attributes{"offset": strconv.Itoa(p.Offset)}
	if p.Role != "" {
		a["role"], a["aria-label"] = p.Role, p.Label
	}
	if p.Hidden {
		a["hidden"] = true
	}
	v.Attrs = with(a, p.Attrs)
	if p.Role == "" {
		v.Label = p.Label
	}
	return v
}
