package layouts

import "net/http"
import "github.com/mbolli/tickit/internal/ui"


func activeClass(r *http.Request, path string) string {
	if r.URL.Path == path {
		return "active"
	}
	return ""
}

templ Base(title string, r *http.Request) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>{ title }</title>
			<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0"/>
			<link rel="icon" type="image/x-icon" href="/static/assets/favicon.ico"/>
			<script defer type="module" src={ui.StaticAssets.HashName("/static/index.mjs")}></script>
			<script defer type="module" src="/static/datastar.js"></script>
			<link href="/static/index.css" rel="stylesheet" type="text/css"/>
		</head>
		<body>
			<header class="container">
				<div
					class="offline-message"
					data-signals-_online="true"
					data-indicator="_connecting"
					data-on-interval__duration.15s.leading="!$_connecting && @get('/api/updates/status', {openWhenHidden: true})"
					data-on-datastar-sse="el === evt.detail.el && ['retrying', 'error', 'finished'].includes(evt.detail.type) && ($_online = false);"
				>
					<div data-show="!$_online">Warning: Not connected to server.</div>
				</div>
				<nav>
					<ul>
						<li><a href="/dashboard" class={ activeClass(r, "/dashboard") }><strong>TickIt</strong></a></li>
					</ul>
					<ul>
						<li><a href="/dashboard" class={ activeClass(r, "/dashboard") }>Dashboard</a></li>
						<li><a href="/create-ticket" class={ activeClass(r, "/create-ticket") }>Create Ticket</a></li>
						<li><a href="/admin" class={ activeClass(r, "/admin") }>Admin Panel</a></li>
					</ul>
					<ul>
						<li><a href="/login">Login</a></li>
						<li><a href="/logout">Logout</a></li>
					</ul>
				</nav>
			</header>
			<main class="container">
				{ children... }
			</main>
			<footer class="container">
				<div id="notifications"></div>
				&copy; 2023 Acme Corp. All rights reserved.
				<script type="module" src="/static/datastar-inspector.js"></script>
				<datastar-inspector></datastar-inspector>
			</footer>
		</body>
	</html>
}
