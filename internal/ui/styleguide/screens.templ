package styleguide

import (
	"time"

	"github.com/zweiundeins/tickit/internal/ui"
)

// doc is a document with every block type, as internal/doc renders one
// (docs/editor.md, "HTML of a document").
templ doc(p Props, carets bool) {
	<h2>Before the release</h2>
	<p>
		This checklist holds for every release of <strong>Board v1</strong>. Work through it top to bottom; when a step is unclear, ask
		@ui.Mention(heron.Seed, heron.Name, "#prose")
		or the team. The open bug is
		@ui.IssueChip(find("WEB-12").chip())
		and it blocks the release.
		if carets {
			Safari reorders lanes
			@ui.Caret("Sunny Otter", ui.FaceOf(sunny.Seed).Hue, false)
			on a slow drag, and <em>only</em> there.
		}
	</p>
	<ul class="task-list">
		<li class="task-item" data-checked="true"><input type="checkbox" aria-label="Done" disabled checked/><div><p>Run the browser tests in Chromium, Firefox and WebKit</p></div></li>
		<li class="task-item" data-checked="true"><input type="checkbox" aria-label="Done" disabled checked/><div><p>Check the contrast test in both themes</p></div></li>
		<li class="task-item" data-checked="false"><input type="checkbox" aria-label="Done" disabled/><div><p>Read the <a href="https://lith.zweiundeins.gmbh/docs" rel="nofollow ugc noopener" title="lith.zweiundeins.gmbh">deploy guide</a> once more</p></div></li>
	</ul>
	<h3>What changed</h3>
	<ol>
		<li>
			if carets {
				@ui.RemoteSelection(ui.FaceOf(heron.Seed).Hue) {
					Cards glide between lanes
				}
				@ui.Caret("Brisk Heron", ui.FaceOf(heron.Seed).Hue, false)
				when someone else moves them.
			} else {
				Cards glide between lanes when someone else moves them.
			}
		</li>
		<li>A refused move says who was first: <code>Sunny Otter moved WEB-12 to In Review first</code>.</li>
		<li>Keyboard moves through the card's menu, see <a class="page-link" data-page="pg-8" href="#prose">Event sourcing</a> and <span class="page-link" data-state="gone">a removed page</span>.</li>
	</ol>
	<blockquote><p>No keystroke of anyone is lost. After they stop, every editor has the same document.</p></blockquote>
	<pre data-language="go"><code>{ "func (c Card) Move(to Lane) error {\n\tif !c.Workflow.Allows(c.Status, to.Status) {\n\t\treturn Refused(\"The workflow does not allow this move.\")\n\t}\n\treturn nil\n}" }</code></pre>
	<h4>Owners</h4>
	<table>
		<tbody>
			<tr><th>Area</th><th>Owner</th><th>Status</th></tr>
			<tr><td>Board</td><td>@ui.Mention(sunny.Seed, sunny.Name, "#prose")</td><td>@ui.IssueChip(ui.IssueChipProps{Key: "WEB-14", Type: ui.Story, Status: "In Progress", Category: ui.InProgress, Href: "/WEB-14", Compact: true})</td></tr>
			<tr><td>Search</td><td>@ui.Mention(heron.Seed, heron.Name, "#prose")</td><td>@ui.IssueChip(ui.IssueChipProps{Key: "WEB-4", Href: "/WEB-4", State: ui.ChipDeleted})</td></tr>
		</tbody>
	</table>
	<hr/>
	<figure class="doc-image"><img src={ p.Mark } alt="tickit's mark: a ticket stub with a tick" width="96" height="96" loading="lazy"/></figure>
	<p>Version compare: the limit is <del class="diff-del">three</del><ins class="diff-ins">four</ins> cards per lane. A link the renderer refused stays text: <span class="link-unsafe">javascript:alert(1)</span>.</p>
}

templ proseSection(p Props) {
	@section("prose", "Prose", "Pages, descriptions and comments in one stylesheet: .prose styles exactly the elements internal/doc renders and the editor's toDOM writes, so reading and editing look the same.") {
		@spec("Every block: headings, lists, task list, quote, code with its language, table, rule, image, chips, mentions, page links, a diff", "<div class=\"prose\">…the document's HTML…</div>") {
			<div class="prose sg-prose">
				@doc(p, false)
			</div>
		}
	}
}

templ editorSection(p Props) {
	@section("editor", "Editor", "The editor's chrome: a toolbar with one tab stop and pressed states, the save status, and other editors' carets with their name tags and selections in their hues (MP-06).") {
		@spec("Editing with two other people", "@ui.EditorToolbar(\"Formatting\", ui.DefaultToolbar) · @ui.EditorStatus(ui.Saving) · @ui.Caret(name, hue, idle)") {
			<div class="tk-editor">
				<div class="tk-editor__bar">
					@ui.EditorToolbar("Formatting", toolbarWithBold())
					@ui.EditorStatus(ui.Saving)
				</div>
				<div class="tk-editor__surface prose">
					@doc(p, true)
				</div>
			</div>
			<div class="cluster">
				@ui.EditorStatus(ui.Saved)
				@ui.EditorStatus(ui.Offline)
			</div>
			@ui.Notice(ui.NoticeProps{Tone: ui.ToneWarn, Title: "Your edits could not be merged", Class: "tk-editor__copy", Action: ui.Button(ui.ButtonProps{Label: "Show my copy", Size: ui.SizeSM})}) {
				<p>The page was reset while you were offline. Your 14 changes are kept as a copy beside the page.</p>
			}
		}
	}
}

func toolbarWithBold() []ui.ToolGroup {
	groups := make([]ui.ToolGroup, len(ui.DefaultToolbar))
	for i, g := range ui.DefaultToolbar {
		groups[i] = append(ui.ToolGroup(nil), g...)
		for j := range groups[i] {
			if groups[i][j].Command == "strong" {
				groups[i][j].Pressed = ui.Pressed(true)
			}
		}
	}
	return groups
}

templ screens(p Props) {
	@section("screens", "Screens", "Composed patterns to copy: a board with a pending and a refused card, an issue page with a conflict, the issue list, a wiki page, notifications, your work and the create dialog.") {
		@screen("screen-board", "Board", "Website · Board") {
			<div class="tk-boardbar">
				<div class="cluster">
					@ui.Input(ui.InputProps{ID: "sg-board-filter", Type: "search", Icon: "search", Placeholder: "Filter cards", Size: ui.SizeSM, Class: "sg-filter"})
					@ui.Checkbox(ui.CheckboxProps{Label: "Only my issues"})
					@ui.Menu(ui.MenuProps{ID: "sg-board-type", Label: "Type", Caret: true, Size: ui.SizeSM, Variant: ui.Secondary}) {
						for i, t := range ui.IssueTypes {
							@ui.MenuItem(ui.MenuItemProps{Label: t.Name(), Checked: ui.Pressed(t == ui.Bug), Autofocus: i == 0})
						}
					}
				</div>
				@ui.PresenceRow(ui.PresenceProps{Label: "People on this board", People: presence(false)[:5]})
			</div>
			@ui.Board(ui.BoardProps{Label: "Board of Website"}) {
				@ui.Lane(ui.LaneProps{ID: "sg-lane-todo", Name: "To Do", Category: ui.ToDo, Count: 3, CreateAttrs: attrs("commandfor", "sg-create", "command", "show-modal")}) {
					@ui.Card(find("WEB-7").card(p.Now, ui.CardIdle, ""))
					@ui.Card(find("WEB-18").card(p.Now, ui.CardLanded, ""))
					@ui.Card(find("WEB-15").card(p.Now, ui.CardIdle, ""))
				}
				@ui.Lane(ui.LaneProps{ID: "sg-lane-progress", Name: "In Progress", Category: ui.InProgress, Count: 3, WIP: 4, Target: true, CreateAttrs: attrs("commandfor", "sg-create", "command", "show-modal")}) {
					@ui.Card(find("WEB-14").card(p.Now, ui.CardIdle, ""))
					@ui.DropMarker()
					@ui.Card(find("WEB-22").card(p.Now, ui.CardPending, ""))
					@ui.Card(find("WEB-24").card(p.Now, ui.CardIdle, ""))
				}
				@ui.Lane(ui.LaneProps{ID: "sg-lane-review", Name: "In Review", Category: ui.InProgress, Count: 5, WIP: 4, CreateAttrs: attrs("commandfor", "sg-create", "command", "show-modal")}) {
					@ui.Card(find("WEB-12").card(p.Now, ui.CardRefused, "Sunny Otter moved WEB-12 to In Review first."))
					@ui.Card(find("WEB-3").card(p.Now, ui.CardIdle, ""))
				}
				@ui.Lane(ui.LaneProps{ID: "sg-lane-done", Name: "Done", Category: ui.Done, Count: 2}) {
					@ui.Card(find("WEB-21").card(p.Now, ui.CardIdle, ""))
					@ui.Card(find("WEB-9").card(p.Now, ui.CardIdle, ""))
				}
			}
		}
		@screen("screen-issue", "Issue page", "Website · WEB-12") {
			@issueBody(p, "sg-")
		}
		@screen("screen-list", "Issue list", "Website · Issues") {
			<div class="tk-pagehead">
				<h1>Issues</h1>
				<div class="cluster">
					@ui.Button(ui.ButtonProps{Label: "Save filter", Icon: "star"})
					@ui.Button(ui.ButtonProps{Label: "Create", Icon: "plus", Variant: ui.Primary, Command: "show-modal", CommandFor: "sg-create"})
				</div>
			</div>
			<div class="sg-filters">
				@ui.Input(ui.InputProps{ID: "sg-list-q", Type: "search", Icon: "search", Placeholder: "Search issues", Value: "board"})
				@ui.Menu(ui.MenuProps{ID: "sg-list-status", Label: "Status: 2", Caret: true, Variant: ui.Secondary}) {
					@ui.MenuItem(ui.MenuItemProps{Label: "To Do", Checked: ui.Pressed(true), Autofocus: true})
					@ui.MenuItem(ui.MenuItemProps{Label: "In Progress", Checked: ui.Pressed(true)})
					@ui.MenuItem(ui.MenuItemProps{Label: "Done", Checked: ui.Pressed(false)})
				}
				@ui.Menu(ui.MenuProps{ID: "sg-list-who", Label: "Assignee", Caret: true, Variant: ui.Secondary}) {
					@ui.MenuItem(ui.MenuItemProps{Label: "Me", Checked: ui.Pressed(false), Autofocus: true})
					@ui.MenuItem(ui.MenuItemProps{Label: "Unassigned", Checked: ui.Pressed(false)})
				}
				@ui.Label("board", "#screen-list")
				@ui.Button(ui.ButtonProps{Label: "Clear", Variant: ui.Ghost, Size: ui.SizeSM})
			</div>
			@issueTable(p, len(issues))
			@ui.Pagination(ui.PaginationProps{Page: 1, Pages: 7, Total: 312, Noun: "issues", Href: func(int) string { return "#screen-list" }})
		}
		@screen("screen-page", "Wiki page", "Engineering · Release checklist") {
			<div class="tk-docpage">
				<aside class="sg-tree" aria-label="Pages">
					<p class="tk-eyebrow">Pages in Engineering</p>
					@ui.Tree(ui.TreeProps{Label: "Pages in Engineering", Items: pageTree()})
				</aside>
				<article class="sg-article">
					<div class="split">
						@ui.Breadcrumbs([]ui.Crumb{{Label: "Engineering", Href: "#screen-page", Icon: "space"}, {Label: "Handbook", Href: "#screen-page"}, {Label: "Releases", Href: "#screen-page"}, {Label: "Release checklist"}})
						@ui.PresenceRow(ui.PresenceProps{Label: "People on this page", People: presence(true)})
					</div>
					<h1 class="sg-doc-title">Release checklist</h1>
					<div class="split sg-docmeta">
						@ui.Byline(ui.BylineProps{Person: sunny, Verb: "edited", At: ago(p.Now, 5*time.Minute).In(zurich), Now: p.Now})
						<div class="cluster">
							@ui.Label("release", "#screen-page")
							@ui.Label("board", "#screen-page")
							@ui.Button(ui.ButtonProps{Label: "Edit", Icon: "edit", Variant: ui.Primary, Size: ui.SizeSM})
							@ui.Button(ui.ButtonProps{Label: "Watch", Icon: "eye", Size: ui.SizeSM})
						</div>
					</div>
					<div class="prose">
						@doc(p, false)
					</div>
				</article>
			</div>
		}
		<div class="sg-pair">
			@screen("screen-notifications", "Notification panel", "The bell's popover") {
				<div class="sg-panelbox">
					@notificationPanel(p)
				</div>
			}
			@screen("screen-empty", "Empty board", "Website · Board, no issues") {
				@ui.EmptyState(ui.EmptyProps{Icon: "board", Title: "Nothing on the board", Text: "Issues in To Do, In Progress and Done show here. Create the first one, or move some out of the backlog.", Action: ui.Button(ui.ButtonProps{Label: "Create issue", Icon: "plus", Variant: ui.Primary, Command: "show-modal", CommandFor: "sg-create"})})
			}
		</div>
		@screen("screen-home", "Your work", "Home") {
			@home(p)
		}
	}
}

// screen frames a composed screen with a title bar.
templ screen(id, title, where string) {
	<figure class="sg-screen" id={ id } aria-labelledby={ id + "-t" }>
		<figcaption class="sg-screen__bar">
			<span class="sg-screen__dots" aria-hidden="true"><i></i><i></i><i></i></span>
			<span class="sg-screen__title" id={ id + "-t" }>{ title }</span>
			<span class="sg-screen__where">{ where }</span>
		</figcaption>
		<div class="sg-screen__body">
			{ children... }
		</div>
	</figure>
}

templ issueBody(p Props, at string) {
	{{ s := find("WEB-12") }}
	<div class="split">
		@ui.Breadcrumbs([]ui.Crumb{{Label: "Website", Href: "#screen-issue", Icon: "folder"}, {Label: "Board v1", Href: "#screen-issue"}, {Label: "WEB-12"}})
		@ui.PresenceRow(ui.PresenceProps{Label: "People on this issue", People: presence(false)[:3]})
	</div>
	<div class="tk-detail sg-issue">
		<div class="stack">
			<div class="sg-issue__head">
				<p class="cluster sg-issue__key">
					@ui.TypeLabel(s.Type)
					<span class="mono">{ s.Key }</span>
					<sb-copy-button value="https://tickit.zweiundeins.gmbh/WEB-12" label="Copy link to WEB-12" copied-label="Copied"></sb-copy-button>
				</p>
				<h1 class="sg-issue__title">{ s.Summary }</h1>
				<div class="cluster">
					@ui.Button(ui.ButtonProps{Label: "In Review", IconEnd: "chevron-down", Variant: ui.Secondary})
					@ui.Button(ui.ButtonProps{Label: "Watching", Icon: "eye", Variant: ui.Ghost, Pressed: "true"})
					@ui.ActionMenu(ui.ActionMenuProps{Label: "More actions", Icon: "more", IconOnly: true, Items: []ui.MenuEntry{{Value: "subtask", Label: "Add subtask"}, {Value: "link", Label: "Link issue"}, {Divider: true}, {Value: "delete", Label: "Delete", Danger: true}}})
				</div>
			</div>
			<div class="prose">
				<p>Dragging a card from <strong>In Progress</strong> to <strong>In Review</strong> in Safari 26 drops it one lane to the right when the board is scrolled. Chromium and Firefox are fine.</p>
				<ol>
					<li>Scroll the board sideways so that In Review is half visible.</li>
					<li>Drag any card onto it.</li>
				</ol>
			</div>
			@ui.Tabs(ui.TabsProps{Labels: []string{"Comments (2)", "History", "Pages (1)"}}) {
				@ui.TabPanel("Comments (2)") {
					<ul class="tk-feed sg-comments" role="list" aria-label="Comments">
						@ui.FeedItem(ui.FeedItemProps{Person: heron, At: ago(p.Now, 40*time.Minute).In(zurich), Now: p.Now}) {
							<b>Brisk Heron</b> Reproduced on an iPad too; the drop marker is in the right place, the card is not.
						}
						@ui.FeedItem(ui.FeedItemProps{Person: sunny, At: ago(p.Now, 6*time.Minute).In(zurich), Now: p.Now}) {
							<b>Sunny Otter</b> The ghost uses page coordinates; Safari reports them before the scroll.
						}
					</ul>
					{{ f := ui.FieldProps{ID: at + "comment", Label: "Add a comment", HideLabel: true} }}
					@ui.Field(f) {
						@ui.Textarea(ui.TextareaProps{ID: f.ID, Rows: 2, Placeholder: "Add a comment", DescribedBy: f.DescribedBy()})
					}
					<p class="sg-typing">
						@ui.Avatar(ui.AvatarProps{Person: lynx, Size: ui.SizeXS, Decorative: true})
						Calm Lynx is typing
					</p>
				}
				@ui.TabPanel("History") {
					<p>Brisk Heron changed the priority from Medium to High.</p>
				}
				@ui.TabPanel("Pages (1)") {
					<p>@ui.PageLink("pg-4", "Release checklist", "#screen-page", false)</p>
				}
			}
		</div>
		<aside class="tk-box sg-side" aria-label="Details">
			<dl class="tk-props">
				<dt>Status</dt>
				<dd>
					@ui.StatusLozenge(s.Status, s.Cat)
				</dd>
				<dt>Assignee</dt>
				<dd>
					@ui.Avatar(ui.AvatarProps{Person: sunny, Size: ui.SizeSM, Decorative: true})
					Sunny Otter
				</dd>
				<dt>Priority</dt>
				<dd class="sg-conflict-field">
					@ui.Select(ui.SelectProps{ID: at + "prio-sel", Size: ui.SizeSM, Invalid: true, DescribedBy: at + "prio-conflict", Attrs: templ.Attributes{"aria-label": "Priority"}, Options: []ui.Option{{Value: "low", Label: "Low"}, {Value: "medium", Label: "Medium"}, {Value: "high", Label: "High"}, {Value: "critical", Label: "Critical", Selected: true}}})
				</dd>
				<dd class="sg-conflict" id={ at + "prio-conflict" }>
					@ui.Notice(ui.NoticeProps{Tone: ui.ToneDanger, Live: true, Action: ui.Button(ui.ButtonProps{Label: "Use Critical anyway", Size: ui.SizeSM})}) {
						<p>Sunny Otter changed the priority to High 5 seconds ago. Your Critical was not saved.</p>
					}
				</dd>
				<dt>Labels</dt>
				<dd>
					@ui.Label("board", "#screen-issue")
					@ui.Label("safari", "#screen-issue")
				</dd>
				<dt>Epic</dt>
				<dd>
					@ui.IssueChip(ui.IssueChipProps{Key: "WEB-3", Summary: "Board v1", Type: ui.Epic, Href: "/WEB-3"})
				</dd>
				<dt>Progress</dt>
				<dd>
					@ui.Progress(5, 8, "Board v1")
				</dd>
				<dt>Story points</dt>
				<dd>
					@ui.Points("3")
				</dd>
				<dt>Due</dt>
				<dd>
					@ui.Due(p.Now.AddDate(0, 0, 2), p.Now, false)
				</dd>
				<dt>Created</dt>
				<dd>
					@ui.RelativeTime(ago(p.Now, 3*24*time.Hour).In(zurich), p.Now)
				</dd>
			</dl>
		</aside>
	</div>
}

templ notificationPanel(p Props) {
	<div class="sg-notif">
		<header class="sg-notif__head">
			<h2 class="tk-eyebrow">Notifications</h2>
			@ui.Button(ui.ButtonProps{Label: "Mark all as read", Variant: ui.Ghost, Size: ui.SizeSM, Icon: "check"})
		</header>
		@ui.Feed("Notifications") {
			@ui.FeedItem(ui.FeedItemProps{Person: sunny, At: ago(p.Now, 2*time.Minute).In(zurich), Now: p.Now, Unread: true, Href: "#screen-page"}) {
				<b>Sunny Otter</b> mentioned you in { " " }
				@ui.PageLink("pg-4", "Release checklist", "#screen-page", false)
			}
			@ui.FeedItem(ui.FeedItemProps{Person: heron, At: ago(p.Now, 25*time.Minute).In(zurich), Now: p.Now, Unread: true, Href: "#screen-issue"}) {
				<b>Brisk Heron</b> assigned you { " " }
				@ui.IssueChip(ui.IssueChipProps{Key: "WEB-14", Summary: "Keyboard moves for board cards", Type: ui.Story, Href: "/WEB-14"})
			}
			@ui.FeedItem(ui.FeedItemProps{Person: lynx, At: ago(p.Now, 3*time.Hour).In(zurich), Now: p.Now, Unread: true}) {
				<b>Calm Lynx</b> commented on { " " }
				@ui.IssueChip(ui.IssueChipProps{Key: "WEB-21", Type: ui.Bug, Href: "/WEB-21", Compact: true})
			}
			@ui.FeedItem(ui.FeedItemProps{Person: marten, At: ago(p.Now, 26*time.Hour).In(zurich), Now: p.Now}) {
				<b>Lucid Marten</b> moved { " " }
				@ui.IssueChip(ui.IssueChipProps{Key: "WEB-9", Type: ui.Story, Status: "Done", Category: ui.Done, Href: "/WEB-9", Compact: true})
			}
		}
		<footer class="sg-notif__foot"><a href="#screen-notifications">All notifications</a></footer>
	</div>
}

templ home(p Props) {
	<div class="tk-pagehead">
		<div>
			<p class="tk-eyebrow">Friday</p>
			<h1>Your work</h1>
		</div>
	</div>
	<div class="sg-homestats">
		@ui.Stats([]ui.Stat{{Label: "Assigned to you", Value: "6"}, {Label: "Due this week", Value: "2", Tone: ui.ToneWarn}, {Label: "Overdue", Value: "1", Tone: ui.ToneDanger}})
	</div>
	<div class="sg-home">
		<section class="tk-box" aria-labelledby="sg-home-assigned">
			<header>
				<h2 class="tk-eyebrow" id="sg-home-assigned">Assigned to you</h2>
				<a href="#screen-list">All</a>
			</header>
			<ul class="sg-worklist" role="list">
				for _, s := range issues[:5] {
					<li>
						@ui.TypeIcon(s.Type)
						<span class="tk-key mono">{ s.Key }</span>
						<a class="truncate" href={ templ.SafeURL("/" + s.Key) }>{ s.Summary }</a>
						@ui.StatusLozenge(s.Status, s.Cat)
					</li>
				}
			</ul>
		</section>
		<section class="tk-box" aria-labelledby="sg-home-recent">
			<header>
				<h2 class="tk-eyebrow" id="sg-home-recent">Recent pages</h2>
			</header>
			<ul class="sg-worklist" role="list">
				<li>
					@ui.PageLink("pg-4", "Release checklist", "#screen-page", false)
					@ui.RelativeTime(ago(p.Now, 5*time.Minute).In(zurich), p.Now)
				</li>
				<li>
					@ui.PageLink("pg-8", "Event sourcing", "#screen-page", false)
					@ui.RelativeTime(ago(p.Now, 26*time.Hour).In(zurich), p.Now)
				</li>
				<li>
					@ui.PageLink("pg-2", "Onboarding", "#screen-page", false)
					@ui.RelativeTime(ago(p.Now, 9*24*time.Hour).In(zurich), p.Now)
				</li>
			</ul>
		</section>
	</div>
}

templ createDialog(p Props) {
	@ui.Dialog(ui.DialogProps{ID: "sg-create", Title: "Create an issue", Description: "In the project Website.", Size: ui.SizeLG, Footer: createFooter()}) {
		<div class="sg-form">
			@ui.RadioGroup(ui.RadioGroupProps{Name: "type", Legend: "Type", Segmented: true, Options: typeOptions(ui.Task)})
			{{ f := ui.FieldProps{ID: "sg-new-summary", Label: "Summary", Required: true, Error: "Write a summary of at most 200 characters."} }}
			@ui.Field(f) {
				@ui.Input(ui.InputProps{ID: f.ID, Name: "summary", Required: true, Invalid: true, MaxLength: 200, DescribedBy: f.DescribedBy(), Attrs: templ.Attributes{"autofocus": true}})
			}
			{{ d := ui.FieldProps{ID: "sg-new-desc", Label: "Description", Optional: true, Hint: "Type @ to mention someone, or an issue key to link it."} }}
			@ui.Field(d) {
				@ui.Textarea(ui.TextareaProps{ID: d.ID, Name: "description", Rows: 4, DescribedBy: d.DescribedBy()})
			}
			<div class="sg-form__row">
				@ui.Picker(ui.PickerProps{Label: "Assignee", Name: "assignee", Searchable: true, Clearable: true, Options: peopleOptions(), Placeholder: "Unassigned"})
				@ui.DatePicker(ui.DatePickerProps{Label: "Due date", Name: "due"})
			</div>
			@ui.RadioGroup(ui.RadioGroupProps{Name: "priority", Legend: "Priority", Segmented: true, Options: prioOptions(ui.Medium)})
			@ui.Outcome(ui.OutcomeProps{ID: "sg-create-outcome", Kind: ui.OutcomeFailed})
		</div>
	}
}

templ createFooter() {
	@ui.Button(ui.ButtonProps{Label: "Cancel", Variant: ui.Ghost, Command: "close", CommandFor: "sg-create"})
	@ui.Button(ui.ButtonProps{Label: "Create", Variant: ui.Primary, Type: "submit", Attrs: templ.Attributes{"data-on:click": pendingDemo}})
}

templ issuePanel(p Props) {
	@ui.SidePanel(ui.PanelProps{ID: "sg-panel", Title: find("WEB-12").Summary, Lead: panelLead(), Actions: ui.Button(ui.ButtonProps{Label: "Open the issue page", Icon: "external", IconOnly: true, Variant: ui.Ghost, Size: ui.SizeSM, Href: "#screen-issue"})}) {
		@issueBody(p, "sgp-")
	}
}

templ panelLead() {
	@ui.TypeIcon(ui.Bug)
	<span>WEB-12</span>
}
