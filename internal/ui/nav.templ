package ui

import "strconv"

// TabsProps is Starbase's sb-tabs: panels in one place, the tab list's
// keyboard and ARIA from the component. Load its bundle ("tabs").
type TabsProps struct {
	Labels   []string
	Selected int
	// Name reports the tab in sb-change, for a feature that keeps it.
	Name  string
	Class string
	Attrs templ.Attributes
}

// Tabs is sb-tabs; the children are a TabPanel per label, in order.
// Before the bundle defines it, the first panel shows.
templ Tabs(p TabsProps) {
	<sb-tabs
		class={ classes("tk-tabs", p.Class) }
		labels={ jsonAttr(p.Labels) }
		if p.Selected > 0 {
			selected={ strconv.Itoa(p.Selected) }
		}
		if p.Name != "" {
			name={ p.Name }
		}
		{ p.Attrs... }
	>
		{ children... }
	</sb-tabs>
}

// TabPanel is the panel of the tab with this label.
templ TabPanel(label string) {
	<div class="tk-tabs__panel" slot={ slug(label) }>
		{ children... }
	</div>
}

// TabNav is a row of links that look like tabs, for views with their own
// URL (an issue's Comments and History as pages, a project's settings).
templ TabNav(label string, items []NavItem) {
	<nav class="tk-tabnav" aria-label={ label }>
		for _, it := range items {
			<a
				href={ templ.SafeURL(it.Href) }
				if it.Current {
					aria-current="page"
				}
			>
				if it.Icon != "" {
					@Icon(it.Icon)
				}
				{ it.Label }
				if it.Count != nil {
					<span class="tk-count">{ strconv.Itoa(*it.Count) }</span>
				}
			</a>
		}
	</nav>
}

// Crumb is a step of a breadcrumb trail.
type Crumb struct {
	Label string
	Href  string
	Icon  string
}

// Breadcrumbs is the trail to the current page; the last crumb is the
// page itself and links nowhere.
templ Breadcrumbs(items []Crumb) {
	<nav class="tk-crumbs" aria-label="Breadcrumbs">
		<ol>
			for i, c := range items {
				<li>
					if i == len(items)-1 {
						<span aria-current="page">
							if c.Icon != "" {
								@Icon(c.Icon)
							}
							{ c.Label }
						</span>
					} else {
						<a href={ templ.SafeURL(c.Href) }>
							if c.Icon != "" {
								@Icon(c.Icon)
							}
							{ c.Label }
						</a>
					}
				</li>
			}
		</ol>
	</nav>
}

// PaginationProps is a long list's pages.
type PaginationProps struct {
	Page, Pages int // 1-based
	Total       int
	// Noun is what the list holds, plural: "issues".
	Noun string
	// Href is the URL of a page.
	Href func(page int) string
}

// pageList is the pages to link: the first, the last, and two around the
// current one; 0 stands for a gap.
func pageList(page, pages int) []int {
	var out []int
	for n := 1; n <= pages; n++ {
		if n == 1 || n == pages || n >= page-1 && n <= page+1 {
			out = append(out, n)
		} else if len(out) > 0 && out[len(out)-1] != 0 {
			out = append(out, 0)
		}
	}
	return out
}

// Pagination is the pages of a list with its count: "Page 2 of 7, 312
// issues", Previous, the pages, Next.
templ Pagination(p PaginationProps) {
	<nav class="tk-pages" aria-label="Pages">
		<p class="tk-pages__count">
			Page { strconv.Itoa(p.Page) } of { strconv.Itoa(max(p.Pages, 1)) }
			<span aria-hidden="true">·</span>
			{ strconv.Itoa(p.Total) } { p.Noun }
		</p>
		if p.Pages > 1 {
			<ul class="tk-pages__list">
				<li>
					if p.Page > 1 {
						@Button(ButtonProps{Label: "Previous page", Icon: "chevron-left", IconOnly: true, Variant: Ghost, Size: SizeSM, Href: p.Href(p.Page - 1)})
					} else {
						@Button(ButtonProps{Label: "Previous page", Icon: "chevron-left", IconOnly: true, Variant: Ghost, Size: SizeSM, Disabled: true})
					}
				</li>
				for _, n := range pageList(p.Page, p.Pages) {
					<li>
						if n == 0 {
							<span class="tk-pages__gap" aria-hidden="true">…</span>
						} else if n == p.Page {
							<a class="tk-pages__page" href={ templ.SafeURL(p.Href(n)) } aria-current="page">
								<span class="visually-hidden">Page </span>{ strconv.Itoa(n) }
							</a>
						} else {
							<a class="tk-pages__page" href={ templ.SafeURL(p.Href(n)) }>
								<span class="visually-hidden">Page </span>{ strconv.Itoa(n) }
							</a>
						}
					</li>
				}
				<li>
					if p.Page < p.Pages {
						@Button(ButtonProps{Label: "Next page", Icon: "chevron-right", IconOnly: true, Variant: Ghost, Size: SizeSM, Href: p.Href(p.Page + 1)})
					} else {
						@Button(ButtonProps{Label: "Next page", Icon: "chevron-right", IconOnly: true, Variant: Ghost, Size: SizeSM, Disabled: true})
					}
				</li>
			</ul>
		}
	</nav>
}

// TreeItem is a node of a Tree: a page and its children, or with no Href
// a plain item to select.
type TreeItem struct {
	ID    string
	Label string
	Href  string
	Icon  string
	// Current is the page shown: highlighted, aria-current, and the item
	// in the tab order; the branches above it open.
	Current bool
	// Expanded opens the branch; the person opens and closes them in the
	// page, which sb-tree keeps through frames.
	Expanded bool
	// Meta shows after the label, muted: a count, "draft".
	Meta     string
	Children []TreeItem
}

// TreeProps is a tree of pages or of items to choose from.
type TreeProps struct {
	ID string
	// Label names the tree: "Pages in Engineering".
	Label string
	Items []TreeItem
	// Name and Value make a tree of plain items one to choose from: the
	// selected item's ID, sent with sb-change {name, value}.
	Name  string
	Value string
	Class string
	Attrs templ.Attributes
}

// Tree is Starbase's sb-tree on the server's nested lists (NFR-47.2):
// links stay links (Enter, a middle click, a new tab), Up and Down move,
// Right and Left open and close, Home and End. Before its bundle runs it
// is the lists themselves. Load its bundle on the page ("tree").
templ Tree(p TreeProps) {
	<sb-tree
		if p.ID != "" {
			id={ p.ID }
		}
		class={ classes("tk-tree", p.Class) }
		label={ p.Label }
		if p.Name != "" {
			name={ p.Name }
			value={ p.Value }
		} else {
			selection="none"
		}
		{ p.Attrs... }
	>
		<ul>
			@treeItems(p.Items)
		</ul>
	</sb-tree>
}

templ treeItems(items []TreeItem) {
	for _, it := range items {
		<li
			data-id={ it.ID }
			if it.Expanded {
				data-open
			}
		>
			if it.Href != "" {
				<a
					href={ templ.SafeURL(it.Href) }
					title={ it.Label }
					if it.Current {
						aria-current="page"
					}
				>
					@treeItemBody(it)
				</a>
			} else {
				<span>
					@treeItemBody(it)
				</span>
			}
			if len(it.Children) > 0 {
				<ul>
					@treeItems(it.Children)
				</ul>
			}
		</li>
	}
}

templ treeItemBody(it TreeItem) {
	@raw(treeIconSVG(iconOr(it.Icon, "page")))
	{ it.Label }
	if it.Meta != "" {
		<span data-meta>{ it.Meta }</span>
	}
}

func iconOr(name, def string) string {
	if name == "" {
		return def
	}
	return name
}

