package pages

import	"github.com/gorilla/sessions"
import "github.com/mbolli/tickit/internal/ui/layouts"
import "net/http"
import "github.com/mbolli/tickit/internal/projects"
import "github.com/mbolli/tickit/internal/issues"

templ CreateTicketPage(store sessions.Store, r *http.Request, projects []*projects.Project) {
	@layouts.Base("New Ticket", store, r) {
		<main class="container" style="max-width: 500px; margin: 2rem auto;">
			<form>
				<h2>New Ticket</h2>
				<label>Title:<input type="text" name="title" required/></label>
				<label>Description:<textarea name="description" required></textarea></label>
				<label>
					Project:
					<select name="project_id">
						<option value="">Select Project</option>
						for _, project := range projects {
							<option value={ project.ID }>{ project.Name }</option>
						}
					</select>
				</label>
				<label>
					Priority:
					<select name="priority">
						for _, priority := range issues.IssuePriorities {
							<option value={ priority } selected?={ priority == issues.IssuePriorityMedium }>{ priority }</option>
						}
					</select>
				</label>
				<label>Attachments:<input type="file" name="attachment"/></label>
				<button type="submit" class="contrast">Submit Ticket</button>
			</form>
		</main>
	}
}
