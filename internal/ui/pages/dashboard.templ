package pages

import "github.com/gorilla/sessions"
import "github.com/mbolli/tickit/internal/ui/layouts"
import "net/http"
import "github.com/go-chi/chi/v5"
import "github.com/mbolli/tickit/internal/projects"

templ DashboardPage(store sessions.Store, r *http.Request, projects []*projects.Project) {
	@layouts.Base("Dashboard", store, r) {
		<section
			class="dashboard"
			data-on-load="@get('/api/updates/issues', {openWhenHidden: true})"
			data-signals__ifmissing="{_drawer: false, _issueLoading: false, filter: { project_id: '', contains_text: ''}}"
			data-on-signal-patch__debounce.200ms="@get('/api/updates/issues', {openWhenHidden: true})"
			data-on-signal-patch-filter="{include: /^filter./}"
		>
			<div class="grid">
				<div class="margin-left: auto;">
					<button>Create Ticket</button>
				</div>
			</div>
			<div class="grid">
				<label>
					Projects
					<select data-bind="filter.project_id">
						<option value="">All</option>
						for _, project := range projects {
							<option value={ project.ID } selected?={ chi.URLParam(r, "project_id") == project.ID }>{ project.Name }</option>
						}
					</select>
				</label>
				<label>
					User
					<select><option>Me</option></select>
				</label>
			</div>
			<div class="grid">
				<input data-bind="filter.contains_text" type="search" placeholder="Search tickets..." style="flex:1;"/>
				<select><option>Filter</option></select>
				<select><option>Sort</option></select>
			</div>
			<!-- Issues table -->
			<div id="issues" aria-busy="true"></div>
			<nav style="margin-top:1rem;text-align:center;">
				<button class="secondary">&lt;</button>
				<button class="secondary">1</button>
				<button class="secondary">2</button>
				<button class="secondary">&gt;</button>
			</nav>
		</section>
		<!-- Slide-in Issue Detail Panel -->
		<div class="slidein-backdrop" data-class-open="$_drawer" data-on-click="$_drawer = false"></div>
		<div
			class="slidein-panel"
			data-class-open="$_drawer"
			data-attr-aria-busy="$_issueLoading"
			data-open-issue={ chi.URLParam(r, "issueUid") }
			data-indicator="_issueLoading"
			data-on-load="if (el.dataset.openIssue != '') { $_drawer = true; @get('/api/updates/issue/' + el.dataset.openIssue) }"
		>
			<div id="issue"></div>
		</div>
	}
}
