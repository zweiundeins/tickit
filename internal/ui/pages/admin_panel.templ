package pages

import "net/http"
import "github.com/mbolli/tickit/internal/ui/layouts"
import "github.com/mbolli/tickit/internal/projects"


templ AdminPanelPage(r *http.Request, projects []*projects.Project) {
	@layouts.Base("Admin Panel", r) {
		<main class="container" style="max-width: 900px; margin: 2rem auto;">
			<nav style="margin-bottom:1rem;">
				<button>Users</button>
				<button>Projects</button>
			</nav>
			<section style="display:flex;gap:2rem;flex-wrap:wrap;">
				<div style="flex:1;min-width:300px;">
					<h3>Users</h3>
					<table role="grid">
						<thead><tr><th>Name</th><th>Role</th><th>Edit</th></tr></thead>
						<tbody>
							<tr><td>John</td><td>Agent</td><td>✎</td></tr>
							<tr><td>Mary</td><td>User</td><td>✎</td></tr>
						</tbody>
					</table>
				</div>
				<div style="flex:1;min-width:300px;">
					<h3>Projects</h3>
					<!-- Create Project Form -->
					<form data-on-submit__viewtransition="@post('/api/projects/', { contentType: 'form' }) && el.reset()">
						<label>Name: <input name="name" type="text" required/></label>
						<label>Slug: <input name="slug" type="text" required/></label>
						<label>Description: <input name="description" type="text"/></label>
						<button type="submit">Create Project</button>
					</form>
					<table role="grid">
						<thead><tr><th>Name</th><th>Slug</th><th>Description</th><th>Status</th><th>Edit</th><th>Actions</th></tr></thead>
						<tbody>
							for _, project := range projects {
								<tr style={ templ.KV("opacity", templ.KV("0.6", project.Archived)) }>
									<td>{ project.Name }</td>
									<td>{ project.Slug }</td>
									<td>{ project.Description }</td>
									<td>
										if project.Archived {
											<span style="color: #666; font-style: italic;">Archived</span>
										} else {
											<span style="color: #28a745;">Active</span>
										}
									</td>
									<td>
										<!-- Edit Project Inline Form -->
										<details>
											<summary>✎</summary>
											<form data-on-submit__viewtransition="@patch('/api/projects/{project.ID}', { contentType: 'json', body: JSON.stringify({ project: { id: '{project.ID}', name: el.querySelector('[name=name]').value, slug: el.querySelector('[name=slug]').value, description: el.querySelector('[name=description]').value } }) })">
												<input type="hidden" name="id" value={ project.ID }/>
												<label>Name: <input name="name" type="text" value={ project.Name } required/></label>
												<label>Slug: <input name="slug" type="text" value={ project.Slug } required/></label>
												<label>Description: <input name="description" type="text" value={ project.Description }/></label>
												<button type="submit">Save</button>
											</form>
										</details>
									</td>
									<td>
										if project.Archived {
											<button data-on-click__viewtransition="@patch('/api/projects/{project.ID}', { contentType: 'json', body: JSON.stringify({ project: { id: '{project.ID}', archived: false } }) })" style="background: #28a745; color: white; border: none; padding: 0.25rem 0.5rem; border-radius: 0.25rem; cursor: pointer;">
												Unarchive
											</button>
										} else {
											<button data-on-click__viewtransition="@patch('/api/projects/{project.ID}', { contentType: 'json', body: JSON.stringify({ project: { id: '{project.ID}', archived: true } }) })" style="background: #6c757d; color: white; border: none; padding: 0.25rem 0.5rem; border-radius: 0.25rem; cursor: pointer;">
												Archive
											</button>
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			</section>
		</main>
	}
}
