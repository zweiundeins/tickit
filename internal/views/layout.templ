package views

import (
	"github.com/mbolli/tickit/internal/people"
	"github.com/mbolli/tickit/internal/ui"
)

// Layout is the document of every page: the head with the one stylesheet,
// the stream, and ui.Shell around the page's content (its children): the
// header, the demo notice, the sidebar, main and the footer. The session's
// preferences are on <html> from the first byte (ui.Prefs).
templ Layout(s Shell) {
	{{ prefs := UIPrefs(s.Prefs) }}
	<!DOCTYPE html>
	<html lang="en" { prefs.Attrs()... }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content={ prefs.ColorScheme() }/>
			<meta name="robots" content="noindex, nofollow"/>
			<title>{ documentTitle(s.Title) }</title>
			if s.Mark != "" {
				<link rel="icon" type="image/svg+xml" href={ s.Mark }/>
			}
			for _, f := range s.Fonts {
				<link rel="preload" href={ f } as="font" type="font/woff2" crossorigin/>
			}
			<link rel="stylesheet" href={ s.CSS }/>
			@meStyle(s.Me.ID)
			@importMap(s)
			<script type="module" src={ s.JS }></script>
			<script type="module" src={ s.NewestFrame }></script>
			for _, src := range s.Scripts {
				<script type="module" src={ src }></script>
			}
		</head>
		<body data-newest-frame data-signals={ signals(s) } data-effect={ follow + "; " + applyPrefs }>
			<div id={ StreamID } hidden data-init={ startStream } data-effect={ beat } data-on-interval__duration.10s={ watchdog } data-on:datastar-fetch={ streamFailed }></div>
			<span hidden data-effect={ displaySettled + "; " + dismissSettled }></span>
			@ui.Shell(ui.ShellProps{
				Header:       header(s),
				Sidebar:      s.Sidebar,
				SidebarLabel: s.SidebarLabel,
				Notice:       DemoNotice(s.NextReset, s.Prefs.HideDemo),
				Footer:       ui.FooterProps{Links: []ui.NavItem{{Label: "Privacy", Href: "/privacy"}, {Label: "Design system", Href: "/design"}}},
				Width:        s.Width,
			}) {
				{ children... }
			}
			if !s.Prefs.HideHint {
				@firstVisitHint()
			}
			<div class="tk-float">
				@DemoAlert(s.DemoAlert)
				@ui.Notice(ui.NoticeProps{Tone: ui.ToneWarn, Icon: "clock", Live: true, Class: "tk-reconnecting", Attrs: templ.Attributes{"id": "reconnecting", "hidden": true, "data-attr:hidden": reconnectHidden}}) {
					<p>Reconnecting…</p>
				}
				@ui.Notice(ui.NoticeProps{Tone: ui.ToneDanger, Class: "tk-problem", Attrs: templ.Attributes{"id": "problem", "role": "alert", "hidden": true, "data-attr:hidden": problemHidden}}) {
					<p data-text="$_problem"></p>
				}
			</div>
			if s.Create != nil {
				@s.Create
			} else {
				@createPlaceholder()
			}
		</body>
	</html>
}

// header is the header of the document's person (FR-137).
func header(s Shell) ui.HeaderProps {
	var admin []ui.NavItem
	if s.Moderates {
		admin = append(admin, ui.NavItem{Label: "Moderation", Href: "/moderation", Icon: "lock", Current: s.Nav == "moderation"})
	}
	if s.Administers {
		admin = append(admin, ui.NavItem{Label: "Admin", Href: "/admin", Icon: "settings", Current: s.Nav == "admin"})
	}
	return ui.HeaderProps{
		Nav:           ui.MainNav(s.Nav),
		Admin:         admin,
		Query:         s.Query,
		// The search box's typeahead (rw/list: views/search.go).
		SearchAttrs:   SearchBoxAttrs(),
		SearchSuggest: SearchSuggestSlot(),
		CreateFor:     CreateID,
		Unread:        s.Bell.Unread,
		Notifications: NotificationPanel(s.Bell),
		Me:            UIPerson(s.Me),
		MeMenu:        personMenu(s),
		Display:       ui.DisplayProps{Prefs: UIPrefs(s.Prefs), Attrs: displayAttrs},
	}
}

// displayAttrs wire a choice of the display menu to POST /cmd/prefs; the
// button carries its preference and value (data-pref, data-value).
func displayAttrs(key, value string) templ.Attributes {
	return templ.Attributes{"data-on:click": setPref, "data-on:datastar-fetch": displayFailed, "data-attr:aria-pressed": prefPressed}
}

// DemoNotice is the notice of every page (DM-10.1), with the time to the
// next reset; the demo view patches it as the reset comes nearer. It stays
// hidden once the person dismissed it, whatever the patch says.
templ DemoNotice(nextReset string, hidden bool) {
	@ui.DemoNotice(ui.DemoProps{
		ID:           "demo-notice",
		NextReset:    nextReset,
		PrivacyHref:  "/privacy",
		Hidden:       hidden,
		Attrs:        templ.Attributes{"data-attr:hidden": demoHidden},
		DismissAttrs: templ.Attributes{"data-on:click": dismissDemo, "data-on:datastar-fetch": dismissFailed, "data-attr:aria-busy": dismissBusy},
	})
}

// firstVisitHint invites a first-time visitor to watch presence work
// (DM-11) until they dismiss it.
templ firstVisitHint() {
	@ui.Notice(ui.NoticeProps{
		Tone:   ui.ToneInfo,
		Icon:   "users",
		Class:  "tk-hint",
		Attrs:  templ.Attributes{"id": "first-visit", "data-attr:hidden": hintHidden},
		Action: ui.Button(ui.ButtonProps{Label: "Dismiss", Icon: "close", IconOnly: true, Variant: ui.Ghost, Size: ui.SizeSM, Attrs: templ.Attributes{"data-on:click": dismissHint, "data-on:datastar-fetch": dismissFailed, "data-attr:aria-busy": dismissBusy}}),
	}) {
		<p>Open this page in a private window to see a second person arrive.</p>
	}
}

// personMenu is what the person's menu holds besides their face and name:
// who they are, their name to change (FR-121), and login or logout.
templ personMenu(s Shell) {
	<div class="tk-me__body">
		if s.Me.Kind == people.Account {
			<p class="tk-me__who">Logged in as staff.</p>
		} else {
			<p class="tk-me__who">You are a guest. Others see this name beside what you do.</p>
		}
		<form class="tk-rename" data-on:submit__prevent={ rename } data-on:datastar-fetch={ renameFailed } data-effect={ renameSettled }>
			{{ f := ui.FieldProps{ID: "rename-name", Label: "Your name"} }}
			@ui.Field(f) {
				<div class="tk-rename__row">
					@ui.Input(ui.InputProps{ID: f.ID, Placeholder: s.Me.Name, Autocomplete: "nickname", MaxLength: people.MaxName, Size: ui.SizeSM, DescribedBy: f.DescribedBy() + " rename-outcome", Attrs: templ.Attributes{"data-bind": "_rename.name", "minlength": "2", "data-attr:readonly": Pending("_rename.op")}})
					@ui.Button(ui.ButtonProps{Label: "Change", Type: "submit", Size: ui.SizeSM, Attrs: templ.Attributes{"data-attr:aria-busy": Busy("_rename.op")}})
				</div>
			}
			@ui.Outcome(ui.OutcomeProps{ID: "rename-outcome", Attrs: templ.Attributes{"data-text": "$_rename.msg", "data-attr:data-kind": renameKind}})
		</form>
	</div>
	@ui.MenuSeparator()
	if s.Me.Kind == people.Account {
		@ui.MenuItem(ui.MenuItemProps{Label: "Log out", Icon: "logout", Attrs: templ.Attributes{"id": "logout", "data-on:click": logout}})
	} else {
		@ui.MenuItem(ui.MenuItemProps{Label: "Log in (staff)", Icon: "login", Href: loginURL(s.Path)})
	}
}

// PersonName is the person's name in the header and in their menu; the
// person view patches both.
templ PersonName(p people.Person) {
	@ui.MeLabel(p.Name)
	@ui.MeName(p.Name)
}

// createPlaceholder is the create dialog until the tracker and the wiki
// bring theirs.
templ createPlaceholder() {
	@ui.Dialog(ui.DialogProps{ID: CreateID, Title: "Create"}) {
		<p>Issues and pages are created here once projects and spaces have moved in.</p>
	}
}

// Presence is the row of faces of the people who have a view open, in the
// order they came, the viewer's own first (meStyle) and at most 8 of them,
// with "+n" for the rest (MP-01, MP-02). Areas put it in their page empty,
// with the id PresenceID of their view's key; the stream fills it.
templ Presence(id string, list []Present) {
	@ui.PresenceRow(ui.PresenceProps{ID: id, Label: "Here now", People: entries(list), Max: Shown, Shared: true})
}
