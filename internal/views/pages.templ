package views

import "github.com/mbolli/tickit/internal/ui"

// Login is the login page of staff (FR-122). Visitors need no account
// (DM-01), and the page publishes no shared password (DM-01.3).
templ Login() {
	<section class="tk-login" aria-labelledby="login-title" data-signals={ loginSignals }>
		<h1 id="login-title">Log in</h1>
		<p class="tk-login__lede">Only the staff of zwei und eins gmbh log in, to moderate and to run the demo. Everyone else uses tickit as a guest, without an account.</p>
		<form class="stack" data-on:submit__prevent={ login } data-on:datastar-fetch={ loginFailed + "; " + loginDone }>
			{{ email := ui.FieldProps{ID: "login-email", Label: "Email", Required: true} }}
			@ui.Field(email) {
				@ui.Input(ui.InputProps{ID: email.ID, Type: "email", Autocomplete: "username", Required: true, DescribedBy: email.DescribedBy(), Attrs: templ.Attributes{"data-bind": "_login.email", "autofocus": true}})
			}
			{{ password := ui.FieldProps{ID: "login-password", Label: "Password", Required: true} }}
			@ui.Field(password) {
				@ui.Input(ui.InputProps{ID: password.ID, Type: "password", Autocomplete: "current-password", Required: true, DescribedBy: password.DescribedBy(), Attrs: templ.Attributes{"data-bind": "_login.password"}})
			}
			@ui.Outcome(ui.OutcomeProps{ID: "login-problem", Attrs: templ.Attributes{"data-text": "$_login.problem", "data-attr:data-kind": loginKind}})
			@ui.Button(ui.ButtonProps{Label: "Log in", Icon: "login", Type: "submit", Variant: ui.Primary, Attrs: templ.Attributes{"data-attr:aria-busy": loginBusy}})
		</form>
	</section>
}

// Privacy says what tickit stores and for how long (DM-10.2, NFR-31).
// Q25: zwei und eins gmbh checks this wording against the Swiss FADP and
// the GDPR before the demo goes live.
templ Privacy() {
	<article class="tk-privacy" aria-labelledby="privacy-title">
		<header class="tk-pagehead">
			<div>
				<p class="tk-eyebrow">The demo and your data</p>
				<h1 id="privacy-title">Privacy</h1>
			</div>
		</header>
		<div class="prose">
			<p>tickit is a public demo run by zwei und eins gmbh. Everything you write here is visible to everyone and deleted at the nightly reset, at 04:00 Swiss time. Please do not enter personal data.</p>
			<h2>As a guest</h2>
			<p>You need no account and give no personal data. Your browser gets one cookie, which holds a random session id. From it, tickit makes a pseudonym, a name like "Sunny Otter" and a face, which others see beside what you do and beside the pages you have open. You may change the name.</p>
			<p>tickit stores what you write (issues, pages, comments), under your pseudonym and with the time, and the state of the pages you have open, which it deletes after 3 days. The nightly reset deletes all of it, your pseudonym included. Your display settings (theme, corners, density, and which notices you closed) stay with the session id until a year after you last changed them.</p>
			<h2>Staff accounts</h2>
			<p>Accounts exist only for the staff of zwei und eins gmbh. An account holds an email address, a username, a full name and a hash of the password. A login lasts 24 hours; tickit keeps it with the browser's name and the times, never the address. Logins, failed logins and changes of roles go into a security log, which keeps them 90 days.</p>
			<h2>Addresses and logs</h2>
			<p>Your network address is held in memory only, to limit how fast one address may make changes, and in the web server's access log, which keeps it 30 days. tickit's own logs hold no text of issues, pages or comments.</p>
			<h2>The one cookie</h2>
			<p>tickit sets one cookie, <code>__Host-sid</code>, which the demo needs to work: it tells tickit which pseudonym, and which login, a request belongs to. It holds a random id and nothing else, and lasts 400 days. tickit sets no other cookie, so it asks for no consent.</p>
			<h2>No third parties</h2>
			<p>Pages load nothing from other sites: no fonts, scripts, images, analytics or embeds.</p>
			<h2>Contact</h2>
			<p>zwei und eins gmbh runs tickit. For questions about your data, write to <a href="mailto:hello@zweiundeins.gmbh">hello@zweiundeins.gmbh</a>.</p>
		</div>
	</article>
}

// NotFound is the page of an address that names nothing, or nothing the
// person may see (NFR-16), with a search box (FR-12.2).
templ NotFound() {
	<section class="tk-error" aria-labelledby="error-title">
		<div class="tk-empty">
			<div class="tk-empty__art">
				@ui.IconSized("search", "xl")
			</div>
			<p class="tk-eyebrow">404</p>
			<h1 class="tk-empty__title" id="error-title">Not found</h1>
			<p class="tk-empty__text">Nothing is at this address, or you may not see it. Search for it, or go to the home page.</p>
			<form class="tk-error__search" role="search" action="/search" method="get">
				<label class="visually-hidden" for="error-search">Search issues and pages</label>
				@ui.Input(ui.InputProps{ID: "error-search", Name: "q", Type: "search", Placeholder: "Search issues and pages", Icon: "search", Autocomplete: "off"})
				@ui.Button(ui.ButtonProps{Label: "Search", Type: "submit"})
			</form>
			@ui.Button(ui.ButtonProps{Label: "Go to the home page", Icon: "home", Variant: ui.Ghost, Href: "/"})
		</div>
	</section>
}

// Gone is the page of something that was deleted.
templ Gone() {
	<section class="tk-error" aria-labelledby="error-title">
		<div class="tk-empty">
			<div class="tk-empty__art">
				@ui.IconSized("trash", "xl")
			</div>
			<p class="tk-eyebrow">410</p>
			<h1 class="tk-empty__title" id="error-title">Deleted</h1>
			<p class="tk-empty__text">What was at this address has been deleted.</p>
			@ui.Button(ui.ButtonProps{Label: "Go to the home page", Icon: "home", Href: "/"})
		</div>
	</section>
}
