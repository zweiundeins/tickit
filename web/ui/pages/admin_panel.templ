package pages

import "net/http"
import "github.com/gorilla/sessions"
import "github.com/mbolli/tickit/web/ui/layouts"
import "github.com/mbolli/tickit/internal/projects"
import "github.com/mbolli/tickit/web/ui/components"

templ AdminPanelPage(store sessions.Store, r *http.Request, projects []*projects.Project, usersList []components.AdminUser) {
	@layouts.Base("Admin Panel", store, r) {
		<main class="container" style="margin: 2rem auto;">
			<nav style="margin-bottom:1rem;">
				<button>Users</button>
				<button>Projects</button>
			</nav>
			<section style="display:flex;gap:2rem;flex-wrap:wrap;">
				<div style="flex:1;min-width:300px;">
					<h3>Users</h3>
					@components.UserForm("", nil)
					@components.UserTable(usersList)
				</div>
				<div style="flex:1;min-width:300px;">
					<h3>Projects</h3>
					@components.ProjectForm("", nil)
					@components.ProjectTable(projects)
				</div>
			</section>
		</main>
	}
}
