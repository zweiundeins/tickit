package pages

import 	"github.com/gorilla/sessions"
import "github.com/mbolli/tickit/web/ui/layouts"
import "net/http"
import "github.com/mbolli/tickit/internal/issues"
import "github.com/mbolli/tickit/internal/projects"

// Accept an issue parameter
templ TicketDetailPage(issue *issues.Issue, projects []*projects.Project, store sessions.Store, r *http.Request) {
	@layouts.Base("Ticket Detail", store, r) {
		<div id="ticket">
			<nav style="margin-bottom:1rem;"><a href="/dashboard">← Back to List</a></nav>
			<section style="border:1px solid var(--muted-border-color);padding:1.5rem;border-radius:8px;">
				<header style="display:flex;align-items:center;justify-content:space-between;">
					{{ var projSlug string }}
					for _, project := range projects {
						if project.ID == issue.ProjectID {
							projSlug = project.Slug
						}
					}
					<h2>Ticket #{ issue.GetKey(projSlug) } - "{ issue.Title }"</h2>
				</header>
				<div style="display:flex;gap:1.5rem;flex-wrap:wrap;margin:1rem 0;">
					<label>
						Status:
						<select name="status">
							for _, status := range issues.IssueStatuses {
								<option value={ status } selected?={ issue.Status == status }>{ status }</option>
							}
						</select>
					</label>
					<label>
						Priority:
						<select name="priority">
							for _, priority := range issues.IssuePriorities {
								<option value={ priority } selected?={ issue.Priority == priority }>{ priority }</option>
							}
						</select>
					</label>
					<label>Assigned to:<select><option>Me</option></select></label>
					<label>
						Project:
						<select name="project_id">
							<option value="">Select Project</option>
							for _, project := range projects {
								<option value={ project.ID } selected?={ issue.ProjectID == project.ID }>{ project.Name }</option>
							}
						</select>
					</label>
				</div>
				<div style="display:flex;gap:2rem;flex-wrap:wrap;">
					<div>Created by: { issue.Reporter }</div>
					<div>Created at: { issue.CreatedAt.Format("2006-01-02 15:04") }</div>
				</div>
				<hr/>
				<div>
					<strong>Description:</strong>
					<p>{ issue.Description }</p>
				</div>
				<hr/>
				<div>
					<strong>Comments:</strong>
					<div style="margin:1rem 0;">
						<div><strong>Max (Agent)</strong> - 10:45<br/><blockquote>We’re investigating this now.</blockquote></div>
					</div>
					<form style="display:flex;gap:0.5rem;align-items:center;">
						<input type="text" placeholder="Add comment..." style="flex:1;"/>
						<label style="margin:0 0.5rem;"><input type="checkbox"/> Internal</label>
						<button type="submit">Submit</button>
					</form>
				</div>
				<hr/>
				<details>
					<summary>History Log ▼</summary>
					<ul><li>Ticket created by John</li></ul>
				</details>
			</section>
		</div>
	}
}
