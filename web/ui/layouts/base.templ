package layouts

import "net/http"

import "github.com/gorilla/sessions"
import "github.com/mbolli/tickit/web/ui"
import "github.com/mbolli/tickit/internal/sharedhttp"
import "github.com/justinas/nosurf"
import "github.com/mbolli/tickit/web/ui/components"

func activeClass(r *http.Request, path string) string {
	if r.URL.Path == path {
		return "active"
	}
	return ""
}

templ Base(title string, sessions sessions.Store, r *http.Request) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<title>{ title }</title>
			<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=0"/>
			<link rel="icon" type="image/x-icon" href="/static/assets/favicon.ico"/>
			<script defer type="module" src={ ui.StaticAssets.HashName("/static/index.mjs") }></script>
			<script defer type="module" src={ ui.StaticAssets.HashName("/static/datastar.js") }></script>
			<link href="/static/index.css" rel="stylesheet" type="text/css"/>
		</head>
		<body 
			data-signals={ "SignalStorage.loadInitialState(" + func() string {
				if connectionJSON, err := templ.JSONString(r.Context().Value("connection_id")); err == nil {
					return connectionJSON
				}
				return "\"\""
			}() + ")" }
     		data-on-signal-patch="SignalStorage.setSignal(patch)"
			if _, state := sharedhttp.GetAuthenticatedUser(sessions, r); state == true {
				data-on-load="@get('/updates', {openWhenHidden: true})"
			}
		>
			<header 
				if _, state := sharedhttp.GetAuthenticatedUser(sessions, r); state == true {
					data-on-signal-patch__debounce.250ms={ "@post('/signals', { headers: { 'X-CSRF-Token': '" + nosurf.Token(r) + "' } })" }
				}
				class="container"
			>
				<div
					class="offline-message"
					data-signals-_online="true"
					data-indicator="_connecting"
					data-on-interval__duration.15s.leading="!$_connecting && @get('/api/updates/status', {openWhenHidden: true})"
					data-on-datastar-fetch="el === evt.detail.el && ['retrying', 'error', 'finished'].includes(evt.detail.type) && ($_online = false);"
				>
					<div data-show="!$_online">Warning: Not connected to server.</div>
				</div>
				<nav>
					<ul>
						<li><a href="/dashboard" class={ activeClass(r, "/dashboard") }><strong>TickIt</strong></a></li>
					</ul>
					<ul>
						<li><a href="/dashboard" class={ activeClass(r, "/dashboard") }>Dashboard</a></li>
						<li><a href="/create-ticket" class={ activeClass(r, "/create-ticket") }>Create Ticket</a></li>
						<li><a href="/admin" class={ activeClass(r, "/admin") }>Admin Panel</a></li>
					</ul>
					<ul>
						if uid, state := sharedhttp.GetAuthenticatedUser(sessions, r); state == true {
							<li><a href="/logout">Logout ({ uid })</a></li>
						} else {
							<li><a href="/auth/login">Login</a></li>
						}
					</ul>
				</nav>
			</header>
			<main class="container">
				{ children... }
			</main>
			<footer class="container">
				@components.Notifications(EmptyNotifications())
				&copy; 2025 zwei und eins gmbh. All rights reserved.
				<script type="module" src="/static/datastar-inspector.js"></script>
				<datastar-inspector></datastar-inspector>
			</footer>
		</body>
	</html>
}
