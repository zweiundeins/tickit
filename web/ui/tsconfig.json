{
    "compilerOptions": {
        "outDir": "./static",
        "sourceMap": true,
        "noImplicitAny": true,
        "module": "esnext",
        "target": "esnext",
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "allowJs": true,
        "lib": [ "es2022", "dom", "dom.iterable" ],
        "typeRoots": [ "node_modules/@types" ],
        "experimentalDecorators": true,
        "moduleResolution": "node",
        "useDefineForClassFields": false
    },
    "include": [
        "./web/ui/js/**/*.ts",
        "./web/ui/js/types/**/*"
    ]
}
